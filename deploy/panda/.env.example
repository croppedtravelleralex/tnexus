# Panda deployment env — copy to /opt/tnexus/.env

TNEXUS_IMAGE=ghcr.io/croppedtravelleralex/tnexus:latest
TNEXUS_ACCOUNT_OPS_IMAGE=ghcr.io/croppedtravelleralex/tnexus-account-ops:latest
TNEXUS_GATEWAY_IMAGE=ghcr.io/croppedtravelleralex/tnexus-gateway:latest
POSTGRES_PASSWORD=change-me

DATABASE_URL=postgres://tnexus:change-me@127.0.0.1:5433/tnexus
REDIS_URL=redis://127.0.0.1:6380
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_TTL_SECS=86400
AUTH_COOKIE_SECURE=1
LISTEN_ADDR=0.0.0.0:9000
CORS_ORIGINS=https://tnexus.relai.asia
GATEWAY_STATIC_DIR=/app/web/out

# Gateway loopback on Panda (same host as nginx tnexus.relai.asia /v1/)
GPTIMAGE_BASE=http://127.0.0.1:8014
GATEWAY_BASE=http://127.0.0.1:8014
# GATEWAY_AUTH_KEY=...           # api 对话代理 → gateway（deploy.sh 与 UPSTREAM_API_KEY 同步刷新）
# ACCOUNT_OPS_TOKEN=...          # account-ops :9011（刷新/重登/OAuth/养号/Outlook/窗口预热）
# QUOTA_PRIME_PROMPT=a tiny red dot on white background
# 禁止配置 GPTIMAGE_ADMIN_TOKEN 代理生产 :8012 — TNexus 已去代理化（留空即可）
GROK2API_BASE=http://127.0.0.1:18000
DIRECTOR_MODEL=gpt-5-mini
CHATGPT_IMAGE_MODEL=gpt-image-2
# Worker: url 生图 + 槽位并行（0 = 不限制并发数）
IMAGE_RESPONSE_FORMAT=url
IMAGE_PARALLEL_CONCURRENCY=0

# UPSTREAM_API_KEY / GATEWAY_AUTH_KEY — refresh via deploy/panda/refresh_upstream_jwt.sh (gateway JWT)

BOOTSTRAP_ADMIN_EMAIL=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me
BOOTSTRAP_DEMO_EMAIL=user
BOOTSTRAP_DEMO_PASSWORD=change-me

# Account pool — prefer Postgres (run scripts/etl_accounts_to_postgres.py once after migrate)
ACCOUNTS_BACKEND=postgres
ACCOUNTS_DB=postgres://tnexus:change-me@127.0.0.1:5433/tnexus
SCHEDULING_STATE_FILE=/data/pool/scheduling_state.json
USAGE_EVENTS_FILE=/data/pool/usage_events.ndjson
PIPELINE_EVENTS_FILE=/data/pool/pipeline_events.ndjson

# Independent OAuth / refresh / nurture / outlook / quota-prime (Rust tnexus-account-ops on :9011)
ACCOUNT_OPS_BASE=http://127.0.0.1:9011
ACCOUNT_OPS_TOKEN=change-me-random-token
# Optional: WEBSHARE_API_KEY for CF scan inventory in account-ops
# NURTURE_DEFAULT_PROMPT=Say hello in one short sentence.
# GPTIMAGE_ROOT only for legacy Python gptimage sidecar (not required for Rust account-ops)

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tnexus-assets

# Local disk image store (default when R2 is not configured)
IMAGE_STORE_PATH=/data/images

PRESIGN_TTL_SECS=1800
