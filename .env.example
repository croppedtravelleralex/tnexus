# TNexus local / Panda
DATABASE_URL=postgres://tnexus:tnexus@localhost:5432/tnexus
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_TTL_SECS=86400
AUTH_COOKIE_SECURE=0
LISTEN_ADDR=0.0.0.0:9000
CORS_ORIGINS=http://localhost:3000,http://localhost:3010,http://127.0.0.1:3000,http://127.0.0.1:3010

GPTIMAGE_BASE=http://127.0.0.1:8012
# 生产 B2：指向独立 Rust gateway，并设置其 GATEWAY_PUBLIC_BASE_URL
# GPTIMAGE_BASE=https://rs.gptimage.relai.asia
GROK2API_BASE=http://127.0.0.1:18000
# 统一网关（NewAPI 等 OpenAI 兼容渠道），设置后优先于上方独立地址
# UPSTREAM_API_BASE=https://sub2api.closeapi.top
# UPSTREAM_API_KEY=sk-your-key
DIRECTOR_MODEL=gpt-4o-mini
CHATGPT_IMAGE_MODEL=gpt-image-2
GROK_IMAGE_MODEL=grok-imagine-image

# Bootstrap admin (synced on every API start)
BOOTSTRAP_ADMIN_EMAIL=admin
BOOTSTRAP_ADMIN_PASSWORD=123456

# Bootstrap demo member (synced on every API start)
BOOTSTRAP_DEMO_EMAIL=user
BOOTSTRAP_DEMO_PASSWORD=123456

# Cloudflare R2 (optional — ChatGPT 生图默认走 gateway URL，可不配 R2)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=tnexus-assets
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

PRESIGN_TTL_SECS=1800
GATEWAY_STATIC_DIR=

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:9000

# Account pool + OAuth/refresh (local dev)
ACCOUNTS_FILE=data/accounts_pool.json
SCHEDULING_STATE_FILE=data/scheduling_state.json
USAGE_EVENTS_FILE=data/usage_events.ndjson
GPTIMAGE_ROOT=/mnt/d/SelfMadeTool/AutoRegister/gptimage
ACCOUNT_OPS_BASE=http://127.0.0.1:9011
ACCOUNT_OPS_TOKEN=tnexus-local-account-ops-dev-token
