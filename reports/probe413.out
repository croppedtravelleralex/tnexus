GPTIMAGE_BASE=http://127.0.0.1:8014
GPTIMAGE_ROOT=/gptimage
IMAGE_ACCOUNT_INFLIGHT_MAX=1
IMAGE_ADMIN_RETRY_MAX=5
IMAGE_ENABLED=1
IMAGE_GLOBAL_CONCURRENCY=10
IMAGE_PARALLEL_CONCURRENCY=10
