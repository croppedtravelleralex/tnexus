            IS_VERSION_FROM_NVMRC=0;
            local NVM_SILENT;
            local NVM_SILENT_ARG;
            local NVM_LTS;
            while [ $# -gt 0 ]; do
                case "$1" in 
                    --silent)
                        NVM_SILENT=1;
                        NVM_SILENT_ARG='--silent';
                        shift
                    ;;
                    --lts)
                        NVM_LTS='*';
                        shift
                    ;;
