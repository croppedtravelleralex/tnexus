                fi;
                if [ "${NVM_SILENT:-0}" -eq 1 ]; then
                    NVM_USE_CMD="${NVM_USE_CMD} --silent";
                fi;
                if ! nvm_die_on_prefix "${NVM_DELETE_PREFIX}" "${NVM_USE_CMD}" "${NVM_VERSION_DIR}"; then
                    return 11;
                fi;
