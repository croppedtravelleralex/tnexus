    PATTERN="${1-}";
    local NVM_FLAVOR;
    if [ -n "${NVM_LTS-}" ]; then
        NVM_FLAVOR="${NVM_NODE_PREFIX}";
    fi;
    case "${PATTERN}" in 
        "${NVM_IOJS_PREFIX}" | "io.js")
