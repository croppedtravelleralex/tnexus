        ;;
        "install-latest-npm")
            if [ $# -ne 0 ]; then
                nvm --help 1>&2;
                return 127;
            fi;
            nvm_install_latest_npm
        ;;
        "reinstall-packages" | "copy-packages")
            if [ $# -ne 1 ]; then
                nvm --help 1>&2;
                return 127;
            fi;
