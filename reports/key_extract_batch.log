        ;;
        'G')
            nvm_echo '1;32m'
        ;;
        'b')
            nvm_echo '0;34m'
        ;;
        'B')
            nvm_echo '1;34m'
        ;;
        'c')
            nvm_echo '0;36m'
        ;;
        'C')
            nvm_echo '1;36m'
        ;;
        'm')
            nvm_echo '0;35m'
        ;;
        'M')
            nvm_echo '1;35m'
        ;;
        'y')
