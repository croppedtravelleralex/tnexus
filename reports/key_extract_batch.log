            fi;
            local nobinary;
            local nosource;
            local noprogress;
            nobinary=0;
            noprogress=0;
            nosource=0;
            local LTS;
            local ALIAS;
            local NVM_UPGRADE_NPM;
            NVM_UPGRADE_NPM=0;
            local PROVIDED_REINSTALL_PACKAGES_FROM;
            local REINSTALL_PACKAGES_FROM;
