nvm () 
{ 
    if [ "$#" -lt 1 ]; then
        nvm --help;
        return;
    fi;
    local DEFAULT_IFS;
    DEFAULT_IFS=" $(nvm_echo t | command tr t \\t)
";
    if [ "${-#*e}" != "$-" ]; then
        set +e;
        local EXIT_CODE;
        IFS="${DEFAULT_IFS}" nvm "$@";
        EXIT_CODE="$?";
        set -e;
        return "$EXIT_CODE";
    else
        if [ "${-#*a}" != "$-" ]; then
            set +a;
            local EXIT_CODE;
            IFS="${DEFAULT_IFS}" nvm "$@";
            EXIT_CODE="$?";
            set -a;
            return "$EXIT_CODE";
        else
            if [ -n "${BASH-}" ] && [ "${-#*E}" != "$-" ]; then
                set +E;
                local EXIT_CODE;
                IFS="${DEFAULT_IFS}" nvm "$@";
                EXIT_CODE="$?";
                set -E;
                return "$EXIT_CODE";
            else
                if [ "${IFS}" != "${DEFAULT_IFS}" ]; then
                    IFS="${DEFAULT_IFS}" nvm "$@";
                    return "$?";
                fi;
            fi;
        fi;
    fi;
    local i;
    for i in "$@";
    do
        case $i in 
            --)
                break
            ;;
            '-h' | 'help' | '--help')
                NVM_NO_COLORS="";
