    if [ "${-#*e}" != "$-" ]; then
        set +e;
        local EXIT_CODE;
        IFS="${DEFAULT_IFS}" nvm "$@";
        EXIT_CODE="$?";
        set -e;
        return "$EXIT_CODE";
    else
        if [ "${-#*a}" != "$-" ]; then
            set +a;
            local EXIT_CODE;
            IFS="${DEFAULT_IFS}" nvm "$@";
            EXIT_CODE="$?";
            set -a;
            return "$EXIT_CODE";
        else
            if [ -n "${BASH-}" ] && [ "${-#*E}" != "$-" ]; then
                set +E;
                local EXIT_CODE;
                IFS="${DEFAULT_IFS}" nvm "$@";
