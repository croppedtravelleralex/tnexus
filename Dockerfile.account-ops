# syntax=docker/dockerfile:1
FROM rust:1.94-bookworm AS builder
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN cargo build --release -p tnexus-account-ops

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/target/release/tnexus-account-ops /usr/local/bin/tnexus-account-ops
ENV ACCOUNT_OPS_LISTEN=127.0.0.1:9011
EXPOSE 9011
CMD ["tnexus-account-ops"]
